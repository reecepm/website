---
import '@/styles/global.css';

interface Props {
  title: string;
  date: Date;
  description?: string;
}

const { title, date, description } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="description" content={description} />
    <title>{title} - Reece Martin</title>
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body class="min-h-screen font-sans leading-relaxed">
    <div class="max-w-[640px] mx-auto px-6 py-12 md:py-16">
      <!-- Header -->
      <header class="flex justify-between items-center mb-16 pb-6 border-b border-border">
        <a href="/" class="font-mono text-sm flex items-center gap-0.5 no-underline">
          <span class="text-muted">~/</span>
          <span class="text-text font-medium">reece-martin</span>
        </a>
        <nav class="flex items-center gap-6">
          <a href="/blog" class="font-mono text-sm text-muted hover:text-accent transition-colors">blog</a>
          <button id="theme-toggle" class="p-2 border border-border text-muted hover:text-accent hover:border-accent transition-all cursor-pointer bg-transparent" aria-label="Toggle theme">
            <svg id="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg id="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden">
              <circle cx="12" cy="12" r="5"></circle>
              <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
            </svg>
          </button>
        </nav>
      </header>

      <!-- Article -->
      <article>
        <header class="mb-12 pb-6 border-b border-border">
          <h1 class="font-mono text-[28px] font-semibold text-text mb-2 tracking-tight">{title}</h1>
          <time datetime={date.toISOString()} class="font-mono text-[13px] text-muted">{formattedDate}</time>
        </header>

        <div class="prose">
          <slot />
        </div>
      </article>

      <!-- Footer -->
      <footer class="mt-16 pt-8 border-t border-border">
        <a href="/blog" class="text-muted no-underline font-mono text-[13px] hover:text-accent transition-colors">
          &larr; back to blog
        </a>
      </footer>
    </div>

    <script>
      function updateThemeIcons() {
        const theme = document.documentElement.getAttribute('data-theme');
        const sunIcon = document.getElementById('sun-icon');
        const moonIcon = document.getElementById('moon-icon');
        if (sunIcon && moonIcon) {
          sunIcon.classList.toggle('hidden', theme !== 'dark');
          moonIcon.classList.toggle('hidden', theme === 'dark');
        }
      }

      updateThemeIcons();

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        updateThemeIcons();
      });
    </script>
  </body>
</html>

<style is:global>
  .prose {
    color: var(--text);
  }

  .prose h1 {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .prose h2 {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    color: var(--text);
  }

  .prose h3 {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .prose p {
    margin-bottom: 1rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose a:hover {
    color: var(--accent-hover);
  }

  .prose ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
    color: var(--text-secondary);
  }

  .prose ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
    color: var(--text-secondary);
  }

  .prose li {
    margin-bottom: 0.25rem;
  }

  .prose code {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    background: var(--tag-bg);
    padding: 0.125rem 0.375rem;
    border-radius: 2px;
    color: var(--text);
  }

  .prose pre {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    background: var(--bg-elevated);
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
    border: 1px solid var(--border);
  }

  .prose pre code {
    background: transparent;
    padding: 0;
  }

  .prose blockquote {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    font-style: italic;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .prose hr {
    border: none;
    border-top: 1px dashed var(--border);
    margin: 2rem 0;
  }

  .prose strong {
    color: var(--text);
    font-weight: 600;
  }
</style>
