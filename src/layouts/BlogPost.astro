---
import ThemeShell from '@/components/ThemeShell.astro';
import { meta } from '@/themes/2026-01-01-monospace-terminal/meta';
import Navigator from '@/themes/2026-01-01-monospace-terminal/Navigator';
import '@/themes/2026-01-01-monospace-terminal/theme.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  date: Date;
  description?: string;
}

const { title, date, description } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const navSlug = `${meta.date}-${meta.id}`;
const siteEntries = await getCollection('site');
const about = siteEntries.find((e) => e.id === 'about')!.data;
---

<ThemeShell meta={meta} title={`${title} - Reece Martin`} description={description}>
  <div class="max-w-[640px] mx-auto px-6 py-12 md:py-16">
    <header class="flex justify-between items-center mb-16 pb-6 border-b border-[var(--mt-border)]">
      <a href="/" class="font-mono text-sm flex items-center gap-0.5 no-underline">
        <span class="text-[var(--mt-muted)]">~/</span>
        <span class="text-[var(--mt-text)] font-medium">reece-martin</span>
      </a>
      <nav class="flex items-center gap-6">
        <a href="/blog" class="font-mono text-sm text-[var(--mt-muted)] hover:text-[var(--mt-accent)] transition-colors">blog</a>
        <button id="theme-toggle" class="p-2 border border-[var(--mt-border)] text-[var(--mt-muted)] hover:text-[var(--mt-accent)] hover:border-[var(--mt-accent)] transition-all cursor-pointer bg-transparent" aria-label="Toggle theme">
          <svg id="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg id="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden">
            <circle cx="12" cy="12" r="5"></circle>
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
          </svg>
        </button>
      </nav>
    </header>

    <article>
      <header class="mb-12 pb-6 border-b border-[var(--mt-border)]">
        <h1 class="font-mono text-[28px] font-semibold text-[var(--mt-text)] mb-2 tracking-tight">{title}</h1>
        <time datetime={date.toISOString()} class="font-mono text-[13px] text-[var(--mt-muted)]">{formattedDate}</time>
      </header>

      <div class="prose pb-12 border-b border-[var(--mt-border)]">
        <slot />
      </div>
    </article>

    <footer class="mt-16 pt-8 border-t border-[var(--mt-border)]">
      <a href="/blog" class="text-[var(--mt-muted)] no-underline font-mono text-[13px] hover:text-[var(--mt-accent)] transition-colors">
        &larr; back to blog
      </a>
    </footer>
  </div>
  <Navigator client:load initialSlug={navSlug} about={about} />
</ThemeShell>

<script>
  const KEY = 'theme-color-scheme';

  function updateThemeIcons() {
    const theme = document.documentElement.getAttribute('data-theme');
    const sunIcon = document.getElementById('sun-icon');
    const moonIcon = document.getElementById('moon-icon');
    if (sunIcon && moonIcon) {
      sunIcon.classList.toggle('hidden', theme !== 'dark');
      moonIcon.classList.toggle('hidden', theme === 'dark');
    }
  }

  function attachToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn || btn.dataset.bound === '1') {
      updateThemeIcons();
      return;
    }
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem(KEY, next);
      updateThemeIcons();
    });
    updateThemeIcons();
  }

  attachToggle();
  document.addEventListener('astro:page-load', attachToggle);
</script>

<style is:global>
  html[data-theme-id="monospace-terminal"] .prose {
    color: var(--mt-text);
  }

  html[data-theme-id="monospace-terminal"] .prose h1 {
    font-family: var(--mt-font-mono);
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--mt-text);
  }

  html[data-theme-id="monospace-terminal"] .prose h2 {
    font-family: var(--mt-font-mono);
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    color: var(--mt-text);
  }

  html[data-theme-id="monospace-terminal"] .prose h3 {
    font-family: var(--mt-font-mono);
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--mt-text);
  }

  html[data-theme-id="monospace-terminal"] .prose p {
    margin-bottom: 1rem;
    line-height: 1.75;
    color: var(--mt-text-secondary);
  }

  html[data-theme-id="monospace-terminal"] .prose a {
    color: var(--mt-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  html[data-theme-id="monospace-terminal"] .prose a:hover {
    color: var(--mt-accent-hover);
  }

  html[data-theme-id="monospace-terminal"] .prose ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
    color: var(--mt-text-secondary);
  }

  html[data-theme-id="monospace-terminal"] .prose ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
    color: var(--mt-text-secondary);
  }

  html[data-theme-id="monospace-terminal"] .prose li {
    margin-bottom: 0.25rem;
  }

  html[data-theme-id="monospace-terminal"] .prose code {
    font-family: var(--mt-font-mono);
    font-size: 0.875rem;
    background: var(--mt-tag-bg);
    padding: 0.125rem 0.375rem;
    border-radius: 2px;
    color: var(--mt-text);
  }

  html[data-theme-id="monospace-terminal"] .prose pre {
    font-family: var(--mt-font-mono);
    font-size: 0.875rem;
    background: var(--mt-bg-elevated);
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
    border: 1px solid var(--mt-border);
  }

  html[data-theme-id="monospace-terminal"] .prose pre code {
    background: transparent;
    padding: 0;
  }

  html[data-theme-id="monospace-terminal"] .prose blockquote {
    border-left: 3px solid var(--mt-accent);
    padding-left: 1rem;
    font-style: italic;
    color: var(--mt-muted);
    margin-bottom: 1rem;
  }

  html[data-theme-id="monospace-terminal"] .prose hr {
    border: none;
    border-top: 1px dashed var(--mt-border);
    margin: 2rem 0;
  }

  html[data-theme-id="monospace-terminal"] .prose strong {
    color: var(--mt-text);
    font-weight: 600;
  }
</style>
