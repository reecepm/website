---
import '@/styles/global.css';
import { getCollection } from 'astro:content';

const experiments = (await getCollection('experiments')).sort((a, b) => a.data.order - b.data.order);
const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const socials = (await getCollection('socials')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);

const socialIcons: Record<string, string> = {
  github: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"></path></svg>`,
  twitter: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>`,
  email: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="M22 6L12 13L2 6"></path></svg>`,
  linkedin: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>`,
};

const formatDate = (date: Date) => {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  return `${year}.${month}`;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>Reece Martin</title>
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body class="min-h-screen font-sans leading-relaxed">
    <div class="max-w-[640px] mx-auto px-6 py-12 md:py-16">
      <!-- Header -->
      <header class="flex justify-between items-center mb-16 pb-6 border-b border-border">
        <div class="font-mono text-sm flex items-center gap-0.5">
          <span class="text-muted">~/</span>
          <span class="text-text font-medium">reece-martin</span>
        </div>
        <nav class="flex items-center gap-6">
          <a href="/blog" class="font-mono text-sm text-muted hover:text-accent transition-colors">blog</a>
          <button id="theme-toggle" class="p-2 border border-border text-muted hover:text-accent hover:border-accent transition-all cursor-pointer bg-transparent" aria-label="Toggle theme">
            <svg id="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg id="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden">
              <circle cx="12" cy="12" r="5"></circle>
              <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
            </svg>
          </button>
        </nav>
      </header>

      <!-- Hero Section -->
      <section class="mb-12 pb-12 border-b border-border">
        <h1 class="font-mono text-[28px] font-semibold text-text mb-2 tracking-tight">Reece Martin</h1>
        <p class="text-base text-muted mb-6">Software Engineer</p>
        <div class="flex flex-wrap gap-6 max-md:flex-col max-md:gap-3">
          <span class="flex items-center gap-2 font-mono text-[13px]">
            <span class="text-accent after:content-[':']">location</span>
            <span class="text-text-secondary">Bristol, UK</span>
          </span>
          <span class="flex items-center gap-2 font-mono text-[13px]">
            <span class="text-accent after:content-[':']">focus</span>
            <span class="text-text-secondary">Backend & AI</span>
          </span>
        </div>
      </section>

      <!-- Experience Section -->
      <section class="flex gap-6 mb-12 max-md:flex-col max-md:gap-4">
        <div class="flex flex-col items-center gap-2 pt-1 max-md:flex-row">
          <span class="w-px h-6 bg-border max-md:w-6 max-md:h-px"></span>
          <span class="font-mono text-[11px] text-muted [writing-mode:vertical-rl] max-md:[writing-mode:horizontal-tb]">01</span>
        </div>
        <div class="flex-1">
          <h2 class="font-mono text-xs font-medium uppercase tracking-widest text-muted mb-5">Experience</h2>
          <div class="flex flex-col gap-px bg-border border border-border">
            {experience.map((exp) => (
              <div class="bg-bg hover:bg-bg-elevated cursor-pointer transition-colors group" data-expandable>
                <div class="flex justify-between items-baseline px-5 py-4 gap-4 max-md:flex-col max-md:gap-1 max-md:px-4 max-md:py-3.5">
                  <span class="font-mono text-[15px] font-medium text-text">{exp.data.company}</span>
                  <span class="flex items-baseline gap-3 font-mono text-[13px] max-md:flex-col max-md:gap-0.5">
                    <span class="text-muted">{exp.data.role}</span>
                    <span class="text-muted opacity-70">{exp.data.dateRange}</span>
                  </span>
                </div>
                <div class="hidden group-[.expanded]:block px-5 pb-5 border-t border-dashed border-border -mt-px max-md:px-4 max-md:pb-4">
                  <p class="text-sm text-text-secondary leading-relaxed mt-4 mb-3">{exp.data.description}</p>
                  <div class="flex flex-wrap gap-2">
                    {exp.data.tags.map((tag) => (
                      <span class="font-mono text-[11px] px-2 py-1 bg-tag-bg text-tag-text border border-border">{tag}</span>
                    ))}
                  </div>
                  {exp.data.url && (
                    <a href={exp.data.url} class="inline-flex items-center gap-1 mt-3 font-mono text-[13px] text-accent hover:text-accent-hover hover:gap-2 transition-all no-underline" target="_blank" rel="noopener noreferrer">
                      Visit website &rarr;
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Experiments Section -->
      <section class="flex gap-6 mb-12 max-md:flex-col max-md:gap-4">
        <div class="flex flex-col items-center gap-2 pt-1 max-md:flex-row">
          <span class="w-px h-6 bg-border max-md:w-6 max-md:h-px"></span>
          <span class="font-mono text-[11px] text-muted [writing-mode:vertical-rl] max-md:[writing-mode:horizontal-tb]">02</span>
        </div>
        <div class="flex-1">
          <h2 class="font-mono text-xs font-medium uppercase tracking-widest text-muted mb-5">Experiments</h2>
          {experiments.length > 0 ? (
            <div class="flex flex-col gap-px bg-border border border-border">
              {experiments.map((exp) => (
                <a href={exp.data.url || '#'} class="block p-5 bg-bg hover:bg-bg-elevated transition-colors no-underline group">
                  <div class="flex justify-between items-center mb-2">
                    <span class="font-mono text-[15px] font-medium text-text">{exp.data.name}</span>
                    <span class="text-muted group-hover:text-accent group-hover:translate-x-1 transition-all">&rarr;</span>
                  </div>
                  <p class="text-sm text-muted leading-normal mb-3">{exp.data.description}</p>
                  <div class="flex gap-2">
                    {exp.data.tags.map((tag) => (
                      <span class="font-mono text-[11px] px-2 py-1 bg-tag-bg text-tag-text border border-border">{tag}</span>
                    ))}
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <p class="font-mono text-sm text-muted p-6 border border-dashed border-border text-center">Nothing here yet. Check back soon.</p>
          )}
        </div>
      </section>

      <!-- Writing Section -->
      <section class="flex gap-6 mb-12 max-md:flex-col max-md:gap-4">
        <div class="flex flex-col items-center gap-2 pt-1 max-md:flex-row">
          <span class="w-px h-6 bg-border max-md:w-6 max-md:h-px"></span>
          <span class="font-mono text-[11px] text-muted [writing-mode:vertical-rl] max-md:[writing-mode:horizontal-tb]">03</span>
        </div>
        <div class="flex-1">
          <h2 class="font-mono text-xs font-medium uppercase tracking-widest text-muted mb-5">Writing</h2>
          {posts.length > 0 ? (
            <>
              <div class="flex flex-col border-t border-dashed border-border">
                {posts.map((post) => (
                  <a href={`/blog/${post.id}`} class="flex gap-4 items-baseline py-4 pl-2 -ml-0.5 border-l-2 border-transparent border-b border-b-border border-dashed hover:border-l-accent transition-colors no-underline max-md:flex-col max-md:gap-1">
                    <span class="font-mono text-xs text-muted shrink-0 w-16 max-md:w-auto">{formatDate(post.data.date)}</span>
                    <span class="text-[15px] text-text hover:text-accent transition-colors">{post.data.title}</span>
                  </a>
                ))}
              </div>
              <a href="/blog" class="inline-flex items-center gap-1 mt-4 font-mono text-[13px] text-accent hover:gap-2 transition-all no-underline">
                view all posts <span>&rarr;</span>
              </a>
            </>
          ) : (
            <p class="font-mono text-sm text-muted p-6 border border-dashed border-border text-center">Nothing here yet. Check back soon.</p>
          )}
        </div>
      </section>

      <!-- Connect Section -->
      <section class="flex gap-6 mb-12 max-md:flex-col max-md:gap-4">
        <div class="flex flex-col items-center gap-2 pt-1 max-md:flex-row">
          <span class="w-px h-6 bg-border max-md:w-6 max-md:h-px"></span>
          <span class="font-mono text-[11px] text-muted [writing-mode:vertical-rl] max-md:[writing-mode:horizontal-tb]">04</span>
        </div>
        <div class="flex-1">
          <h2 class="font-mono text-xs font-medium uppercase tracking-widest text-muted mb-5">Connect</h2>
          <div class="flex flex-wrap gap-3 max-md:flex-col">
            {socials.map((social) => (
              <a
                href={social.data.url}
                class="inline-flex items-center gap-2 px-4 py-3 bg-bg-elevated border border-border text-text font-mono text-[13px] hover:border-accent hover:text-accent transition-all no-underline max-md:justify-center"
                target={social.data.url.startsWith('mailto:') ? undefined : '_blank'}
                rel={social.data.url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
              >
                <Fragment set:html={socialIcons[social.data.icon]} />
                <span>{social.data.name}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- Footer -->
      <footer class="mt-16 pt-8 border-t border-border">
        <div class="flex items-center font-mono text-xs">
          <span class="text-muted" id="year"></span>
          <div class="flex-1 h-px bg-border mx-4"></div>
          <span class="text-muted inline-flex items-center">
            always learning<span class="w-0.5 h-3.5 bg-accent ml-0.5 animate-blink"></span>
          </span>
        </div>
      </footer>
    </div>

    <script>
      document.getElementById('year')!.textContent = new Date().getFullYear().toString();

      document.querySelectorAll('[data-expandable]').forEach(item => {
        item.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) return;
          item.classList.toggle('expanded');
        });
      });

      function updateThemeIcons() {
        const theme = document.documentElement.getAttribute('data-theme');
        const sunIcon = document.getElementById('sun-icon');
        const moonIcon = document.getElementById('moon-icon');
        if (sunIcon && moonIcon) {
          sunIcon.classList.toggle('hidden', theme !== 'dark');
          moonIcon.classList.toggle('hidden', theme === 'dark');
        }
      }

      updateThemeIcons();

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        updateThemeIcons();
      });
    </script>
  </body>
</html>
