---
import '@/styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sketches — Receipt Theme Era Studies</title>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <main>
      <header>
        <h1>Receipt printer — era studies</h1>
        <p>
          Three static mockups of the same scene (counter · register · product display · printed
          receipt) in different visual eras. Pick a feel, then we build the live interaction on
          top.
        </p>
      </header>

      <section class="grid">
        <a class="card card--vintage" href="/sketches/vintage">
          <span class="card-era">Era I</span>
          <span class="card-title">1910 — General Store</span>
          <span class="card-note">brass &amp; ledger paper · serif · mechanical</span>
        </a>

        <a class="card card--nineties" href="/sketches/nineties">
          <span class="card-era">Era II</span>
          <span class="card-title">1995 — Convenience Store</span>
          <span class="card-note">beige &amp; LCD · monospace · fluorescent</span>
        </a>

        <a class="card card--modern" href="/sketches/modern">
          <span class="card-era">Era III</span>
          <span class="card-title">2026 — Specialty Counter</span>
          <span class="card-note">tablet &amp; thermal · sans · warm minimal</span>
        </a>
      </section>

      <footer>
        <a href="/">&larr; back to site</a>
      </footer>
    </main>

    <style>
      html,
      body {
        margin: 0;
        background: #18130c;
        color: #ece4d2;
        font-family: 'Inter', -apple-system, sans-serif;
        min-height: 100%;
      }

      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 80px 32px 60px;
      }

      header h1 {
        font-size: 32px;
        font-weight: 600;
        margin: 0 0 12px;
        letter-spacing: -0.01em;
      }

      header p {
        font-size: 14px;
        color: #a89c80;
        max-width: 560px;
        margin: 0 0 48px;
        line-height: 1.55;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      @media (max-width: 880px) {
        .grid { grid-template-columns: 1fr; }
      }

      .card {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 28px 24px 32px;
        text-decoration: none;
        color: inherit;
        border-radius: 6px;
        position: relative;
        overflow: hidden;
        min-height: 240px;
        transition: transform 0.18s ease, box-shadow 0.18s ease;
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: var(--card-bg);
        opacity: 0.96;
        z-index: 0;
      }

      .card::after {
        content: '';
        position: absolute;
        inset: 0;
        background: var(--card-overlay, none);
        z-index: 1;
        pointer-events: none;
      }

      .card > * {
        position: relative;
        z-index: 2;
      }

      .card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 36px rgba(0, 0, 0, 0.4);
      }

      .card-era {
        font-size: 10px;
        letter-spacing: 0.4em;
        opacity: 0.7;
        text-transform: uppercase;
      }

      .card-title {
        font-size: 22px;
        font-weight: 600;
        margin-top: auto;
        letter-spacing: -0.005em;
      }

      .card-note {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        opacity: 0.7;
        letter-spacing: 0.04em;
      }

      .card--vintage {
        --card-bg: radial-gradient(ellipse at 70% 30%, #5a3a1c 0%, #1a0e08 80%);
        color: #f1e3c4;
      }
      .card--vintage::after {
        background: radial-gradient(
          circle at 30% 80%,
          rgba(184, 137, 58, 0.4),
          transparent 50%
        );
      }

      .card--nineties {
        --card-bg: linear-gradient(160deg, #d8cda8 0%, #a89c78 100%);
        color: #2a2a1a;
      }
      .card--nineties::after {
        background:
          repeating-linear-gradient(
            0deg,
            transparent 0 22px,
            rgba(0, 0, 0, 0.03) 22px 23px
          );
      }

      .card--modern {
        --card-bg: linear-gradient(160deg, #f4ede1 0%, #ddc7a8 100%);
        color: #1f1a14;
      }
      .card--modern::after {
        background: radial-gradient(
          ellipse at 75% 20%,
          rgba(255, 220, 150, 0.5),
          transparent 60%
        );
      }

      footer {
        margin-top: 60px;
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }

      footer a {
        color: #a89c80;
        text-decoration: none;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
      }
      footer a:hover {
        color: #ece4d2;
      }
    </style>
  </body>
</html>
