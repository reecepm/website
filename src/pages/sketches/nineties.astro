---
import '@/styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sketch — 90s POS</title>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=VT323&family=Share+Tech+Mono&family=Roboto+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <div class="scene">
      <!-- fluorescent ceiling light bar -->
      <div class="ceiling">
        <div class="ceiling-grid"></div>
        <div class="fluorescent">
          <div class="bulb"></div>
        </div>
      </div>

      <!-- back wall: scuffed white with that fluorescent green tint -->
      <div class="wall"></div>

      <!-- counter: speckled linoleum -->
      <div class="counter"></div>
      <div class="counter-edge"></div>

      <!-- floor: industrial vinyl tile -->
      <div class="floor"></div>

      <!-- product wall behind the counter -->
      <div class="product-wall">
        <div class="prod prod--blue">
          <div class="prod-brand">REECE™</div>
          <div class="prod-name">ABOUT</div>
          <div class="prod-flavor">Original Recipe</div>
          <div class="prod-net">NET 0.5 oz</div>
          <div class="prod-barcode">
            <div class="bc">
              <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
            </div>
            <div class="bc-num">0 24600 31142 7</div>
          </div>
        </div>

        <div class="prod prod--red">
          <div class="prod-brand">REECE™</div>
          <div class="prod-name">JOURNAL</div>
          <div class="prod-flavor">Extra Sharp</div>
          <div class="prod-net">NET 12 OZ</div>
          <div class="prod-barcode">
            <div class="bc">
              <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
            </div>
            <div class="bc-num">0 24600 31415 9</div>
          </div>
        </div>

        <div class="prod prod--yellow">
          <div class="prod-brand">REECE™</div>
          <div class="prod-name">PROJECTS</div>
          <div class="prod-flavor">Family Size</div>
          <div class="prod-net">NET 18 OZ</div>
          <div class="prod-barcode">
            <div class="bc">
              <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
            </div>
            <div class="bc-num">0 24600 27182 8</div>
          </div>
        </div>

        <div class="prod prod--green">
          <div class="prod-brand">REECE™</div>
          <div class="prod-name">CONTACT</div>
          <div class="prod-flavor">Travel Pack</div>
          <div class="prod-net">NET 3 OZ</div>
          <div class="prod-barcode">
            <div class="bc">
              <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
            </div>
            <div class="bc-num">0 24600 16180 3</div>
          </div>
        </div>
      </div>

      <!-- THE POS -->
      <div class="pos">
        <!-- thermal printer mounted on top -->
        <div class="printer">
          <div class="printer-vent"></div>
          <div class="printer-slot"></div>
          <div class="printer-paper">
            <div class="r-line r-head">******************</div>
            <div class="r-line r-head">REECE MART #042</div>
            <div class="r-line r-head">2026-05-13  14:22</div>
            <div class="r-line r-head">******************</div>
            <div class="r-line">ABOUT       1.99T</div>
            <div class="r-line">JOURNAL     3.49T</div>
            <div class="r-line">PROJECTS    4.99T</div>
            <div class="r-line">--------------</div>
            <div class="r-line">SUBTOTAL   10.47</div>
            <div class="r-line">TAX         0.73</div>
            <div class="r-line r-emph">TOTAL     $11.20</div>
            <div class="r-line">CASH      $20.00</div>
            <div class="r-line">CHANGE     $8.80</div>
          </div>
        </div>

        <!-- the body of the POS -->
        <div class="pos-body">
          <!-- LCD -->
          <div class="lcd">
            <div class="lcd-glass">
              <div class="lcd-row">PROJECTS     #027</div>
              <div class="lcd-row">QTY  1   $  4.99</div>
              <div class="lcd-cursor">SUBTOT $ 10.47<span class="blink">_</span></div>
            </div>
            <div class="lcd-bezel"></div>
          </div>

          <!-- numeric + function keypad -->
          <div class="keypad">
            <div class="krow">
              <button class="k">7</button>
              <button class="k">8</button>
              <button class="k">9</button>
              <button class="k k--fn">VOID</button>
            </div>
            <div class="krow">
              <button class="k">4</button>
              <button class="k">5</button>
              <button class="k">6</button>
              <button class="k k--fn">CLR</button>
            </div>
            <div class="krow">
              <button class="k">1</button>
              <button class="k">2</button>
              <button class="k">3</button>
              <button class="k k--fn">SUB</button>
            </div>
            <div class="krow">
              <button class="k">0</button>
              <button class="k">.</button>
              <button class="k k--cash">CASH</button>
              <button class="k k--enter">ENTER</button>
            </div>
          </div>

          <!-- side strip of category quick keys -->
          <div class="qkeys">
            <button class="qk qk-a">ABOUT</button>
            <button class="qk qk-b">JOURNAL</button>
            <button class="qk qk-c">PROJECTS</button>
            <button class="qk qk-d">CONTACT</button>
          </div>

          <!-- branding -->
          <div class="pos-brand">DataMax 4200</div>
          <div class="pos-led"></div>
        </div>

        <!-- scanner on the counter to the left -->
        <div class="scanner">
          <div class="scanner-eye"></div>
          <div class="scanner-stand"></div>
          <div class="scanner-base"></div>
        </div>
      </div>

      <!-- caption -->
      <div class="caption">
        <span class="caption-era">Era II</span>
        <span class="caption-title">1995 — Convenience Store</span>
        <span class="caption-note">beige &amp; LCD · monospace · fluorescent</span>
      </div>

      <a href="/sketches" class="back-link">&larr; back to sketches</a>
    </div>

    <style>
      :root {
        --beige: #d8cda8;
        --beige-d: #a89c78;
        --beige-l: #ecdfb6;
        --yellow-keys: #c8b88a;
        --lcd-bg: #5a6d40;
        --lcd-on: #c8e068;
        --linoleum: #d3cdb5;
        --wall: #b8c4a8;
        --barcode: #1a1a1a;
        --thermal: #ebe6d7;
      }

      html,
      body {
        margin: 0;
        height: 100%;
        background: #2a2a26;
        overflow: hidden;
        font-family: 'Roboto Mono', 'Courier New', monospace;
      }

      .scene {
        position: relative;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
      }

      .ceiling {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 9%;
        background: linear-gradient(180deg, #c0c4b0 0%, #9aa088 100%);
        overflow: hidden;
      }

      .ceiling-grid {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(90deg, rgba(0, 0, 0, 0.2) 1px, transparent 1px),
          linear-gradient(0deg, rgba(0, 0, 0, 0.2) 1px, transparent 1px);
        background-size: 120px 60px;
      }

      .fluorescent {
        position: absolute;
        top: 18px;
        left: 22%;
        right: 22%;
        height: 10px;
        background: linear-gradient(180deg, #2a2a26 0%, #4a4a40 100%);
        border-radius: 2px;
      }

      .bulb {
        position: absolute;
        inset: 1px;
        background: linear-gradient(180deg, #fffce0 0%, #f4f0b0 100%);
        box-shadow:
          0 0 30px 4px rgba(255, 255, 200, 0.6),
          0 0 60px 12px rgba(255, 255, 200, 0.25);
      }

      .wall {
        position: absolute;
        top: 9%;
        left: 0;
        right: 0;
        bottom: 42%;
        background:
          radial-gradient(
            ellipse at 50% 0%,
            rgba(255, 255, 200, 0.18),
            transparent 50%
          ),
          linear-gradient(180deg, var(--wall) 0%, #a0ac90 100%);
      }

      .counter {
        position: absolute;
        bottom: 8%;
        left: 0;
        right: 0;
        height: 34%;
        background:
          radial-gradient(circle at 12% 18%, rgba(0, 0, 0, 0.18) 0 1.5px, transparent 2px),
          radial-gradient(circle at 38% 62%, rgba(0, 0, 0, 0.2) 0 1.5px, transparent 2px),
          radial-gradient(circle at 72% 30%, rgba(0, 0, 0, 0.18) 0 1.5px, transparent 2px),
          radial-gradient(circle at 88% 78%, rgba(0, 0, 0, 0.2) 0 1.5px, transparent 2px),
          radial-gradient(circle at 24% 88%, rgba(0, 0, 0, 0.15) 0 1.5px, transparent 2px),
          radial-gradient(circle at 56% 12%, rgba(0, 0, 0, 0.18) 0 1.5px, transparent 2px),
          linear-gradient(180deg, var(--linoleum) 0%, #b6b0a0 100%);
        background-size: 40px 40px, 60px 60px, 30px 30px, 50px 50px, 35px 35px, 45px 45px, auto;
      }

      .counter-edge {
        position: absolute;
        bottom: 42%;
        left: 0;
        right: 0;
        height: 5px;
        background: linear-gradient(180deg, #4a4a40 0%, #2a2a26 100%);
      }

      .floor {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 8%;
        background:
          repeating-linear-gradient(
            90deg,
            #6a685c 0 60px,
            #5a5850 60px 62px,
            #6a685c 62px 122px,
            #5a5850 122px 124px
          );
      }

      /* PRODUCT WALL */
      .product-wall {
        position: absolute;
        top: 13%;
        left: 4%;
        width: 40%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        padding: 10px;
        background: rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.15);
      }

      .prod {
        background: var(--prod-c, #b89048);
        padding: 8px 8px 4px;
        font-family: 'Roboto Mono', monospace;
        color: white;
        text-shadow: 0 1px 0 rgba(0, 0, 0, 0.3);
        display: flex;
        flex-direction: column;
        gap: 1px;
        position: relative;
        box-shadow:
          inset 0 -10px 16px rgba(0, 0, 0, 0.18),
          inset 0 6px 8px rgba(255, 255, 255, 0.18),
          0 4px 10px rgba(0, 0, 0, 0.45);
        transition: transform 0.15s ease;
        cursor: pointer;
      }
      .prod:hover { transform: translateY(-3px); }

      .prod--blue   { --prod-c: #1f4a8a; }
      .prod--red    { --prod-c: #b21f2a; }
      .prod--yellow { --prod-c: #d4a417; color: #2a1a00; text-shadow: 0 1px 0 rgba(255,255,255,0.3); }
      .prod--green  { --prod-c: #2a6a3a; }

      .prod-brand {
        font-size: 10px;
        letter-spacing: 0.15em;
        opacity: 0.85;
      }
      .prod-name {
        font-size: 18px;
        font-weight: 700;
        letter-spacing: 0.04em;
        font-family: 'Share Tech Mono', monospace;
      }
      .prod-flavor {
        font-size: 10px;
        font-style: italic;
        opacity: 0.85;
      }
      .prod-net {
        font-size: 9px;
        letter-spacing: 0.1em;
        opacity: 0.75;
        margin-top: 2px;
      }

      .prod-barcode {
        margin-top: 6px;
        background: white;
        padding: 3px 4px 1px;
      }
      .bc {
        display: flex;
        gap: 1px;
        align-items: stretch;
        height: 18px;
      }
      .bc span {
        background: var(--barcode);
        display: block;
      }
      .bc span:nth-child(1) { width: 2px; }
      .bc span:nth-child(2) { width: 1px; }
      .bc span:nth-child(3) { width: 3px; }
      .bc span:nth-child(4) { width: 1px; }
      .bc span:nth-child(5) { width: 2px; }
      .bc span:nth-child(6) { width: 4px; }
      .bc span:nth-child(7) { width: 1px; }
      .bc span:nth-child(8) { width: 2px; }
      .bc span:nth-child(9) { width: 1px; }
      .bc span:nth-child(10) { width: 3px; }
      .bc span:nth-child(11) { width: 2px; }
      .bc span:nth-child(12) { width: 1px; }
      .bc span:nth-child(13) { width: 4px; }
      .bc span:nth-child(14) { width: 2px; }
      .bc span:nth-child(15) { width: 1px; }
      .bc span:nth-child(16) { width: 3px; }
      .bc span:nth-child(17) { width: 1px; }
      .bc span:nth-child(18) { width: 2px; }
      .bc span:nth-child(19) { width: 1px; }
      .bc span:nth-child(20) { width: 2px; }
      .bc-num {
        font-size: 8px;
        color: black;
        text-align: center;
        letter-spacing: 0.05em;
        margin-top: 1px;
      }

      /* POS BODY */
      .pos {
        position: absolute;
        bottom: 11%;
        left: 50%;
        transform: translateX(-30%);
        width: 460px;
      }

      .printer {
        position: relative;
        background: linear-gradient(180deg, var(--beige-l) 0%, var(--beige) 60%, var(--beige-d) 100%);
        height: 78px;
        border-radius: 6px 6px 0 0;
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.4),
          inset 0 -2px 6px rgba(0, 0, 0, 0.15);
        margin: 0 30px;
      }

      .printer-vent {
        position: absolute;
        top: 10px;
        right: 14px;
        width: 38px;
        height: 28px;
        background:
          repeating-linear-gradient(
            0deg,
            #2a2a26 0 2px,
            transparent 2px 5px
          );
      }

      .printer-slot {
        position: absolute;
        bottom: 6px;
        left: 22px;
        width: 220px;
        height: 4px;
        background: #1a1a16;
        border-radius: 2px;
        box-shadow: 0 -1px 0 rgba(0, 0, 0, 0.4);
      }

      .printer-paper {
        position: absolute;
        top: 100%;
        left: 26px;
        width: 212px;
        background: var(--thermal);
        padding: 12px 14px 18px;
        font-family: 'VT323', 'Share Tech Mono', monospace;
        font-size: 14px;
        line-height: 1.25;
        color: #2a2a26;
        box-shadow:
          0 14px 28px rgba(0, 0, 0, 0.5),
          inset 0 1px 0 rgba(0, 0, 0, 0.15);
        clip-path: polygon(
          0 0, 100% 0, 100% 100%,
          94% 96%, 88% 100%, 82% 95%, 76% 99%, 70% 95%, 64% 100%, 58% 96%,
          52% 100%, 46% 95%, 40% 99%, 34% 95%, 28% 100%, 22% 96%, 16% 100%,
          10% 95%, 4% 99%, 0 96%
        );
      }

      .r-line {
        white-space: pre;
      }
      .r-head {
        text-align: center;
      }
      .r-emph {
        font-weight: 700;
        letter-spacing: 0.02em;
        margin-top: 2px;
      }

      /* POS BODY (main beige box) */
      .pos-body {
        position: relative;
        background: linear-gradient(180deg, var(--beige-l) 0%, var(--beige) 50%, var(--beige-d) 100%);
        border-radius: 10px 10px 16px 16px;
        padding: 18px 22px 24px;
        box-shadow:
          inset 0 2px 0 rgba(255, 255, 255, 0.4),
          inset 0 -4px 8px rgba(0, 0, 0, 0.15),
          0 16px 30px rgba(0, 0, 0, 0.55);
      }

      .lcd {
        background: var(--lcd-bg);
        padding: 10px 14px;
        border-radius: 3px;
        position: relative;
        box-shadow:
          inset 0 0 0 2px #2a2a20,
          inset 0 2px 6px rgba(0, 0, 0, 0.5);
        margin-bottom: 16px;
      }

      .lcd-glass {
        font-family: 'VT323', monospace;
        color: var(--lcd-on);
        font-size: 22px;
        line-height: 1.2;
        text-shadow: 0 0 6px rgba(200, 224, 104, 0.65);
        letter-spacing: 0.08em;
      }

      .lcd-row {
        white-space: pre;
      }

      .lcd-cursor .blink {
        animation: blink 1s steps(1) infinite;
      }
      @keyframes blink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
      }

      .keypad {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .krow {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
      }

      .k {
        background: linear-gradient(180deg, var(--yellow-keys) 0%, #a08c5c 100%);
        border: none;
        color: #2a1a05;
        font-family: 'Share Tech Mono', monospace;
        font-size: 15px;
        font-weight: 700;
        padding: 12px 0;
        border-radius: 4px;
        cursor: pointer;
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.3),
          inset 0 -3px 0 rgba(0, 0, 0, 0.2),
          0 2px 3px rgba(0, 0, 0, 0.3);
      }
      .k:active {
        transform: translateY(2px);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.3),
          inset 0 -1px 0 rgba(0, 0, 0, 0.2);
      }

      .k--fn {
        background: linear-gradient(180deg, #8e7a4a 0%, #6a583a 100%);
        color: #f0e6c0;
        font-size: 11px;
        letter-spacing: 0.1em;
      }
      .k--cash {
        background: linear-gradient(180deg, #356d8a 0%, #1d4d6a 100%);
        color: white;
        font-size: 12px;
        letter-spacing: 0.1em;
      }
      .k--enter {
        background: linear-gradient(180deg, #5a8a40 0%, #2a5a20 100%);
        color: white;
        font-size: 12px;
        letter-spacing: 0.1em;
      }

      .qkeys {
        position: absolute;
        top: 18px;
        right: -136px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        background: var(--beige-d);
        padding: 14px 10px;
        border-radius: 6px;
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.25),
          0 8px 18px rgba(0, 0, 0, 0.45);
      }

      .qk {
        background: linear-gradient(180deg, #f3ebc5 0%, #c8b88a 100%);
        border: none;
        font-family: 'Share Tech Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.1em;
        font-weight: 700;
        color: #2a1a05;
        padding: 10px 14px;
        border-radius: 3px;
        cursor: pointer;
        text-align: left;
        min-width: 110px;
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.5),
          inset 0 -2px 0 rgba(0, 0, 0, 0.15);
        border-left: 4px solid var(--qk-c, #888);
      }

      .qk-a { --qk-c: #1f4a8a; }
      .qk-b { --qk-c: #b21f2a; }
      .qk-c { --qk-c: #d4a417; }
      .qk-d { --qk-c: #2a6a3a; }

      .pos-brand {
        position: absolute;
        bottom: 4px;
        right: 20px;
        font-family: 'Share Tech Mono', monospace;
        font-size: 9px;
        letter-spacing: 0.2em;
        color: #5a4a20;
        opacity: 0.6;
      }

      .pos-led {
        position: absolute;
        bottom: 8px;
        left: 22px;
        width: 6px;
        height: 6px;
        background: #d22a2a;
        border-radius: 50%;
        box-shadow: 0 0 6px #ff4040, inset 0 -1px 0 rgba(0, 0, 0, 0.4);
      }

      /* SCANNER on counter */
      .scanner {
        position: absolute;
        bottom: -12px;
        left: -180px;
        width: 130px;
        height: 130px;
      }
      .scanner-base {
        position: absolute;
        bottom: 0;
        width: 130px;
        height: 14px;
        background: linear-gradient(180deg, var(--beige) 0%, var(--beige-d) 100%);
        border-radius: 6px;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.4);
      }
      .scanner-stand {
        position: absolute;
        bottom: 12px;
        left: 50%;
        transform: translateX(-50%);
        width: 18px;
        height: 60px;
        background: linear-gradient(180deg, var(--beige-d) 0%, var(--beige) 100%);
      }
      .scanner-eye {
        position: absolute;
        bottom: 64px;
        left: 50%;
        transform: translateX(-50%);
        width: 80px;
        height: 60px;
        background: linear-gradient(180deg, var(--beige-l) 0%, var(--beige-d) 100%);
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
      }
      .scanner-eye::before {
        content: '';
        position: absolute;
        top: 16px;
        left: 50%;
        transform: translateX(-50%);
        width: 56px;
        height: 26px;
        background: radial-gradient(ellipse, #5a0000 30%, #1a0000 90%);
        border-radius: 50%;
        box-shadow: inset 0 0 8px rgba(255, 50, 50, 0.6);
      }
      .scanner-eye::after {
        content: '';
        position: absolute;
        top: 27px;
        left: 12px;
        right: 12px;
        height: 1px;
        background: #ff3838;
        box-shadow: 0 0 8px #ff3838;
      }

      /* CAPTION */
      .caption {
        position: absolute;
        top: 18px;
        left: 24px;
        color: #2a2a26;
        font-family: 'Share Tech Mono', monospace;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .caption-era {
        font-size: 11px;
        letter-spacing: 0.4em;
        opacity: 0.55;
      }
      .caption-title {
        font-size: 22px;
        letter-spacing: 0.05em;
        font-weight: 700;
      }
      .caption-note {
        font-size: 11px;
        opacity: 0.55;
